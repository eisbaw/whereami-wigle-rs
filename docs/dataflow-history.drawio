<mxfile host="Electron" agent="whereami-dataflow-history" version="29.0.3">
  <diagram name="History" id="history">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="History — stay-point segmentation over the fixes timeseries" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="200" y="30" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="On-demand. history.rs::segment_fixes groups fixes within 100m into stay-points; segments shorter than 300s are dropped. Centroid via geometric_median. Periodic prune deletes fixes older than retention_days." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="40" y="68" width="1320" height="40" as="geometry" />
        </mxCell>

        <!-- TCP client + server + history.rs -->
        <mxCell id="cli" value="TCP client&#xa;whereami history 7d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="60" y="220" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="server" value="server.rs&#xa;&#xa;TCP :4747&#xa;dispatch_command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="340" y="220" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="history" value="history.rs&#xa;&#xa;segment_fixes,&#xa;stay-points,&#xa;geometric_median centroid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="620" y="200" width="240" height="140" as="geometry" />
        </mxCell>

        <!-- fixes table -->
        <mxCell id="fixes" value="fixes&#xa;at_rfc3339, lat, lon,&#xa;accuracy_m, n_sources" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="960" y="220" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Prune loop -->
        <mxCell id="pruneloop" value="history prune&#xa;periodic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;strokeWidth=2;fontStyle=2;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="960" y="440" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_cli_srv" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="cli" target="server" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_cli_srv" value="JSON request" style="edgeLabel;html=1;fontSize=11;" parent="e_cli_srv" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_srv_hist" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="server" target="history" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_srv_hist" value="range (from, to) → Vec&amp;lt;Segment&amp;gt;" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_hist" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_hist_fixes" style="endArrow=classic;html=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="history" target="fixes" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_hist_fixes" value="select range → Vec&amp;lt;FixRow&amp;gt;" style="edgeLabel;html=1;fontSize=11;" parent="e_hist_fixes" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_srv_cli" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#888888;exitX=0;exitY=1;entryX=1;entryY=1;" parent="1" source="server" target="cli" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="380" />
              <mxPoint x="260" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="el_srv_cli" value="JSON response" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_cli" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_prune_fixes" style="endArrow=classic;html=1;dashed=1;strokeColor=#9673a6;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" parent="1" source="pruneloop" target="fixes" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_prune_fixes" value="delete WHERE at &lt; now - retention_days" style="edgeLabel;html=1;fontSize=11;" parent="e_prune_fixes" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="lg_bg" value="external = red border, loop = purple dashed, processing = blue, SQLite = green cylinder. Edges: solid = data, dashed (purple) = trigger, dotted = read, dim grey = response." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="40" y="610" width="1300" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
