<mxfile host="Electron" agent="whereami-dataflow-locate" version="29.0.3">
  <diagram name="Locate" id="locate">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Locate — turning visible BSSIDs into a position" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="400" y="30" width="1100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="On-demand. Cache-only read path (no provider calls). filter_outliers (drop_isolated + geometric median) then weighted spherical-mean trilateration. Writes one fix row + last_fix." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="120" y="70" width="1660" height="24" as="geometry" />
        </mxCell>

        <!-- Top row of inputs server reads from (debouncer snapshot, aps cache) -->
        <mxCell id="debouncer" value="Debouncer&#xa;&#xa;ring buffer, stable APs" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="380" y="170" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="aps" value="aps&#xa;cached lat/lon per BSSID" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="700" y="170" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Middle row: pipeline -->
        <mxCell id="cli" value="TCP client&#xa;whereami CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="server" value="server.rs&#xa;&#xa;TCP :4747&#xa;dispatch_command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="280" y="400" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="filt" value="filter_outliers&#xa;&#xa;drop_isolated +&#xa;geometric_median" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="560" y="400" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="trilat" value="trilaterate&#xa;&#xa;weighted spherical mean&#xa;antimerid-safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="860" y="400" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="addr" value="address resolver&#xa;&#xa;background task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1160" y="400" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="addrcache" value="AddressCache&#xa;&#xa;TTL+LRU, cap 256" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1440" y="400" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nom" value="OSM Nominatim&#xa;opt-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1700" y="400" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Bottom row: write targets -->
        <mxCell id="fixes" value="fixes&#xa;timeseries" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="780" y="640" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lastfix" value="last_fix&#xa;single row, hot" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="990" y="640" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Edges: pipeline -->
        <mxCell id="e_cli_srv" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="cli" target="server" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_cli_srv" value="JSON request" style="edgeLabel;html=1;fontSize=11;" parent="e_cli_srv" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_srv_deb" style="endArrow=classic;html=1;dashPattern=1 3;strokeWidth=2;exitX=0.4;exitY=0;entryX=0.5;entryY=1;" parent="1" source="server" target="debouncer" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_srv_deb" value="snapshot" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_deb" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_srv_aps" style="endArrow=classic;html=1;dashPattern=1 3;strokeWidth=2;exitX=0.7;exitY=0;entryX=0.5;entryY=1;" parent="1" source="server" target="aps" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_srv_aps" value="get_ap (read)" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_aps" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_srv_filt" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="server" target="filt" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_srv_filt" value="Vec&amp;lt;PositionedAp&amp;gt;" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_filt" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_filt_trilat" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="filt" target="trilat" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_filt_trilat" value="kept APs" style="edgeLabel;html=1;fontSize=11;" parent="e_filt_trilat" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_trilat_addr" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="trilat" target="addr" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_trilat_addr" value="lat/lon" style="edgeLabel;html=1;fontSize=11;" parent="e_trilat_addr" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_addr_cache" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="addr" target="addrcache" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_addr_cache" value="check/store" style="edgeLabel;html=1;fontSize=11;" parent="e_addr_cache" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_cache_nom" style="endArrow=classic;html=1;strokeWidth=2;" parent="1" source="addrcache" target="nom" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_cache_nom" value="GET (miss)" style="edgeLabel;html=1;fontSize=11;" parent="e_cache_nom" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <!-- Trilat -> writes -->
        <mxCell id="e_trilat_fixes" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" parent="1" source="trilat" target="fixes" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_trilat_fixes" value="insert" style="edgeLabel;html=1;fontSize=11;" parent="e_trilat_fixes" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="e_trilat_last" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" parent="1" source="trilat" target="lastfix" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_trilat_last" value="upsert" style="edgeLabel;html=1;fontSize=11;" parent="e_trilat_last" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <!-- Boot rehydrate (dim grey) -->
        <mxCell id="e_lastfix_srv" style="endArrow=classic;html=1;dashPattern=1 3;strokeWidth=2;strokeColor=#888888;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" parent="1" source="lastfix" target="server" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="el_lastfix_srv" value="rehydrate at boot" style="edgeLabel;html=1;fontSize=11;" parent="e_lastfix_srv" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <!-- Response back to client (dim grey, arcs below) -->
        <mxCell id="e_srv_cli" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#888888;exitX=0;exitY=1;entryX=1;entryY=1;" parent="1" source="server" target="cli" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="580" />
              <mxPoint x="220" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="el_srv_cli" value="JSON response" style="edgeLabel;html=1;fontSize=11;" parent="e_srv_cli" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <!-- Compact legend -->
        <mxCell id="lg_bg" value="external = red border, processing = blue, in-memory = yellow, SQLite = green cylinder. Edges: solid = data, dotted = read, dim grey = response/rehydrate." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;fontColor=#444444;" parent="1" vertex="1">
          <mxGeometry x="40" y="800" width="1700" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
