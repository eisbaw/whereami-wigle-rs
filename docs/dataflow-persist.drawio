<mxfile host="Electron" agent="whereami-dataflow-persist" version="29.0.3">
  <diagram name="Persist" id="persist">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Persist — SQLite (WAL) topology: who writes, who reads" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="350" y="30" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Schema v5. Six tables. Every write is transactional (run_migration helper); WAL mode keeps reads non-blocking. Each table here shows its writers (above) and readers (below)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="80" y="68" width="1740" height="36" as="geometry" />
        </mxCell>

        <!-- Writers row (top): processing components -->
        <mxCell id="w_resolver" value="resolver.rs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="80" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_trilat" value="trilaterate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1020" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_wigle" value="provider::wigle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="1580" y="200" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Tables row (middle) -->
        <mxCell id="aps" value="aps&#xa;bssid PK, lat, lon, ssid,&#xa;source, source_priority,&#xa;first_seen, last_seen" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="380" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="notfound" value="not_found&#xa;bssid PK,&#xa;not_found_at,&#xa;TTL revival" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="320" y="380" width="200" height="160" as="geometry" />
