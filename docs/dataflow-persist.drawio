        <mxCell id="el_w5" value="upsert" style="edgeLabel;html=1;fontSize=10;" parent="w5" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

        <mxCell id="w6" style="endArrow=classic;html=1;strokeWidth=2;dashPattern=1 3;strokeColor=#82b366;" parent="1" source="w_wigle" target="meta" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="el_w6" value="atomic reserve" style="edgeLabel;html=1;fontSize=10;" parent="w6" vertex="1" connectable="0"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>

