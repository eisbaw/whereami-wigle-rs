        <mxCell id="w4" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" parent="1" source="w_trilat" target="fixes" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
